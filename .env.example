# Groq LLM API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Deepgram Voice API Configuration (STT & TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_TTS_VOICE=aura-asteria-en

# Email Notification Configuration (Gmail SMTP)
ADMIN_EMAIL=zaiqaboxkarachi@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=zaiqaboxkarachi@gmail.com
SMTP_PASSWORD=

# Database Configuration (MS SQL Server / SQLite)
USE_SQL_SERVER=true
SQL_SERVER_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=ZaiqaBoxDB;Trusted_Connection=yes;

# Google Sheets Webhook URL (Optional)
SHEET_WEBHOOK_URL=

# Security & CORS settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Server Host & Port
HOST=0.0.0.0
PORT=8000
